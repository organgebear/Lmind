# ============================================================
# Lmind 项目配置
# 复制此文件为 .env 并填写实际值（.env 已在 .gitignore 中）
# ============================================================
#
# 安全提示：请勿将填写了真实密码的 .env 文件提交到 Git！

# ---------- 初始化开关 ----------
# true = 已完成初始化，直接进入登录页
# false = 首次启动，进入 Setup 页面配置
INITIALIZED=false

# ---------- 数据库 ----------
# 类型: sqlite | mysql
DB_TYPE=mysql

# SQLite 配置（DB_TYPE=sqlite 时生效）
DB_PATH=./data/lmind.db

# MySQL 配置（DB_TYPE=mysql 时生效）
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ---------- Redis（可选） ----------
# 留空则不启用 Redis
# 格式: redis://:password@host:port
REDIS_URL=redis://:your_redis_password@your_redis_host:6379
